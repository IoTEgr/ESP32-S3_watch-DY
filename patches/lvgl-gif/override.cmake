# Pin the GIF composition/timing fix in the project, surviving dependency refresh.
if(CONFIG_LV_USE_GIF)
    idf_component_get_property(_gif_lib lvgl__lvgl COMPONENT_LIB)
    get_target_property(_gif_sources ${_gif_lib} SOURCES)
    set(_gif_remaining "")
    set(_gif_count 0)
    foreach(_source IN LISTS _gif_sources)
        get_filename_component(_gif_name "${_source}" NAME)
        if(_gif_name STREQUAL "lv_gif.c")
            math(EXPR _gif_count "${_gif_count} + 1")
        else()
            list(APPEND _gif_remaining "${_source}")
        endif()
    endforeach()
    if(NOT _gif_count EQUAL 1)
        message(FATAL_ERROR "Review local GIF fix after LVGL upgrade: expected one lv_gif.c")
    endif()
    set_property(TARGET ${_gif_lib} PROPERTY SOURCES "${_gif_remaining}")
    target_sources(${_gif_lib} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/lv_gif.c")
endif()
