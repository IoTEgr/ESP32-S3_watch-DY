# One master switch. Change OFF to ON, then build/flash as usual.
set(WATCH_DEBUG OFF)

# Keep SDK/bootloader/LVGL logging and RTOS profiling in the same build mode.
# Only the debug-related keys below are managed; all other sdkconfig options
# (board, memory, networking, fonts, etc.) retain their existing values.
if(DEFINED SDKCONFIG)
    get_filename_component(_watch_config "${SDKCONFIG}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_LIST_DIR}")
else()
    set(_watch_config "${CMAKE_CURRENT_LIST_DIR}/sdkconfig")
endif()
set(_watch_config_text "")
if(EXISTS "${_watch_config}")
    file(READ "${_watch_config}" _watch_config_text)
else()
    # A clean clone has no sdkconfig yet; select this board before IDF's
    # early target discovery (which otherwise defaults to ESP32).
    set(_watch_config_text "CONFIG_IDF_TARGET=\"esp32s3\"\n")
endif()
set(_watch_config_before "${_watch_config_text}")
set(_watch_profile_text "")

macro(watch_debug_option key enabled)
    if(${enabled})
        set(_watch_expected "CONFIG_${key}=y")
    else()
        set(_watch_expected "# CONFIG_${key} is not set")
    endif()
    string(APPEND _watch_profile_text "${_watch_expected}\n")
    string(REGEX MATCHALL "(^|\n)(CONFIG_${key}=[^\n]*|# CONFIG_${key} is not set)" _watch_matches "${_watch_config_text}")
    list(LENGTH _watch_matches _watch_count)
    string(STRIP "${_watch_matches}" _watch_existing)
    if(NOT _watch_count EQUAL 1 OR NOT _watch_existing STREQUAL _watch_expected)
        string(REGEX REPLACE "(^|\n)(CONFIG_${key}=[^\n]*|# CONFIG_${key} is not set)" "" _watch_config_text "${_watch_config_text}")
        string(REGEX REPLACE "\n+$" "" _watch_config_text "${_watch_config_text}")
        string(APPEND _watch_config_text "\n${_watch_expected}")
    endif()
endmacro()

foreach(_level NONE ERROR WARN INFO DEBUG VERBOSE)
    set(_app_level FALSE)
    if((WATCH_DEBUG AND _level STREQUAL "INFO") OR (NOT WATCH_DEBUG AND _level STREQUAL "NONE"))
        set(_app_level TRUE)
    endif()
    watch_debug_option("LOG_DEFAULT_LEVEL_${_level}" _app_level)
    watch_debug_option("BOOTLOADER_LOG_LEVEL_${_level}" _app_level)
    # Deprecated aliases can otherwise reintroduce an old selection on reload.
    watch_debug_option("LOG_BOOTLOADER_LEVEL_${_level}" _app_level)
    if(NOT _level STREQUAL "NONE")
        watch_debug_option("LOG_MAXIMUM_LEVEL_${_level}" FALSE)
    endif()
endforeach()
watch_debug_option(LOG_MAXIMUM_EQUALS_DEFAULT TRUE)
watch_debug_option(LV_USE_LOG WATCH_DEBUG)
if(WATCH_DEBUG)
    watch_debug_option(LV_LOG_PRINTF TRUE)
endif()
watch_debug_option(FREERTOS_GENERATE_RUN_TIME_STATS WATCH_DEBUG)
# No SDK lock-profiler was enabled before this switch; keep it disabled.
watch_debug_option(PM_PROFILING FALSE)
foreach(_level DEBUG INFO WARNING ERROR NONE)
    set(_utils_level FALSE)
    if((WATCH_DEBUG AND _level STREQUAL "INFO") OR (NOT WATCH_DEBUG AND _level STREQUAL "NONE"))
        set(_utils_level TRUE)
    endif()
    watch_debug_option("ESP_UTILS_CONF_LOG_LEVEL_${_level}" _utils_level)
endforeach()
if(NOT _watch_config_text MATCHES "\n$")
    string(APPEND _watch_config_text "\n")
endif()
if(NOT _watch_config_text STREQUAL _watch_config_before)
    file(WRITE "${_watch_config}" "${_watch_config_text}")
endif()
# set-target recreates sdkconfig inside project.cmake. Supply the same options
# as the final defaults file as well, so the switch also survives that path.
set(_watch_profile "${CMAKE_BINARY_DIR}/watch-debug.defaults")
set(_watch_profile_before "")
if(EXISTS "${_watch_profile}")
    file(READ "${_watch_profile}" _watch_profile_before)
endif()
if(NOT _watch_profile_before STREQUAL _watch_profile_text)
    file(WRITE "${_watch_profile}" "${_watch_profile_text}")
endif()
if(NOT DEFINED SDKCONFIG_DEFAULTS)
    if(DEFINED ENV{SDKCONFIG_DEFAULTS} AND NOT "$ENV{SDKCONFIG_DEFAULTS}" STREQUAL "")
        set(SDKCONFIG_DEFAULTS "$ENV{SDKCONFIG_DEFAULTS}")
    elseif(EXISTS "${CMAKE_CURRENT_LIST_DIR}/sdkconfig.defaults")
        set(SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_LIST_DIR}/sdkconfig.defaults")
    endif()
endif()
list(APPEND SDKCONFIG_DEFAULTS "${_watch_profile}")
list(REMOVE_DUPLICATES SDKCONFIG_DEFAULTS)
if(WATCH_DEBUG)
    add_compile_definitions(WATCH_DEBUG_ENABLED=1)
else()
    add_compile_definitions(WATCH_DEBUG_ENABLED=0)
endif()
message(STATUS "Watch debug output and measurements: ${WATCH_DEBUG}")
